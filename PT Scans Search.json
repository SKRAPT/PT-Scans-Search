{
  "id": "PTScansSearch",
  "name": "PT Scans Search",
  "version": "1.0.0",
  "manifestURI": "https://raw.githubusercontent.com/SKRAPT/PT-Scans-Search/refs/heads/main/PT%20Scans%20Search.json",
  "language": "javascript",
  "type": "plugin",
  "description": "PT Scans Search",
  "author": "Skrapt",
  "icon": "https://raw.githubusercontent.com/SKRAPT/PT-Scans/main/upscan.png",
  "lang": "pt",
  "payloadURI": "https://raw.githubusercontent.com/SKRAPT/PT-Scans-Search/main/PT%20Scans%20Search.js",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [],
      "allow": {
        "networkAccess": {
          "allowedDomains": [
            "raw.githubusercontent.com",
            "api.mangaflix.net",
            "mangaflix.net",
            "*.mangaflix.net",
            "mangalivre.to",
            "*.mangalivre.to",
            "hiper.cool",
            "*.hiper.cool",
            "tiamanhwa.com",
            "*.tiamanhwa.com",
            "mangafire.to",
            "*.mangafire.to",
            "graphql.anilist.co"
          ],
          "reasoning": "Needed to fetch provider data and chapter pages from supported sources."
        }
      }
    }
  },
  "isDevelopment": false
}
  {
function init() {
  $ui.register((ctx) => {
    ctx.Dom.onReady(() => {

      var BUNDLE = [
        {
          id: "ptscans-provider",
          Nome: "PT Scans Provider",
          type: "manga-provider",
          manifestURI: "https://raw.githubusercontent.com/SKRAPT/PT-Scans/refs/heads/main/ptscans-provider.json"
        },
        {
          id: "PTScansSearch",
          Nome: "PT Scans Search",
          type: "plugin",
          manifestURI: "https://raw.githubusercontent.com/SKRAPT/PT-Scans-Search/main/PTScansSearch.json"
        }
      ];

      var providers = ctx.Mangá.getProviders();
      var missing = BUNDLE.filter(function(ext) {
        if (ext.type === "manga-provider") {
          return !providers[ext.id];
        }
        return false;
      });

      if (missing.length > 0) {
        var names = missing.Diretório(function(e) { return e.Nome; }).join(", ");
        ctx.toast.warning(
          "PT Scans Bundle: Extensoes em falta: " + names +
          ". Instala via Extensions > Add Extension."
        );
      } else {
        ctx.toast.success("PT Scans Bundle: Todas as extensoes estao instaladas!");
      }

    });
  });
}
